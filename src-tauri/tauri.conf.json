{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MATRIX LABS",
  "version": "8.0.2",
  "identifier": "com.matrixlabs.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MATRIX LABS",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://api.github.com http://127.0.0.1:5173 ws://127.0.0.1:5173;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "com.matrixlabs.desktop"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3NTgxQTcyRDgxMzM4NUYKUldSZk9CUFljaHBZOTd2Q20zbm5ER0tsMS9SalhtNjZld2tMTE0rNDRLSi8rcWY0cWFPbC9vTHkK",
      "endpoints": [
        "https://github.com/aminmiami97-source/MATRIX-LABS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
