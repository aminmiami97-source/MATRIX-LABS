<Window x:Class="MATRIXCustumuse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MATRIX Custumuse" Height="820" Width="1280" MinHeight="720" MinWidth="1040"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" Foreground="#F5F3FF" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" CornerRadius="18" GlassFrameThickness="0"
                            ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B8B7C9"/>
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#20FFFFFF"/>
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="#45BDA8FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#358E70E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#986EFF"/>
            <Setter Property="BorderBrush" Value="#C3AFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B6CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#AC8DFF"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E1D6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D9D5E8"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButton" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#28FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9D91C7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CharacterSpacing" Value="120"/>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="18" BorderThickness="1" BorderBrush="#55FFFFFF"
            Background="#160B0D18">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Soft color bloom behind the glass layers -->
            <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="500" Height="500" Canvas.Left="570" Canvas.Top="-210" Opacity="0.24">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#9C7AFF" Offset="0"/>
                            <GradientStop Color="#507A5BFF" Offset="0.45"/>
                            <GradientStop Color="#007A5BFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="48"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="380" Height="380" Canvas.Left="-190" Canvas.Top="360" Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#45A9FF" Offset="0"/>
                            <GradientStop Color="#304A9CFF" Offset="0.5"/>
                            <GradientStop Color="#004A9CFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="42"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="#0EFFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="31" Height="31" CornerRadius="10" BorderBrush="#85C9B7FF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#B49BFF" Offset="0"/>
                                <GradientStop Color="#5D46B5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="M" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MATRIX CUSTUMUSE" FontSize="12" FontWeight="Bold" Foreground="#F6F2FF"/>
                        <TextBlock Text="PERSONALIZATION STUDIO" FontSize="8" Foreground="#A99CCF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="#17FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="9"
                            Padding="10,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#A98BFF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="PREVIEW BUILD 0.1.1" FontSize="9" Foreground="#D7CFFF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click" Margin="0,0,5,0"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="□" Click="Maximize_Click" Margin="0,0,5,0"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="×" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- App workspace -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="238"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#17FFFFFF" BorderBrush="#23FFFFFF" BorderThickness="0,1,1,0">
                    <DockPanel Margin="17,20,17,18">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="9,0,0,11"/>
                            <Button Style="{StaticResource NavButton}" Background="#2E9B7BFF" BorderBrush="#5BBAA4FF" Foreground="White" Content="⌂   Overview"/>
                            <Button Style="{StaticResource NavButton}" Content="◇   Theme Gallery"/>
                            <Button Style="{StaticResource NavButton}" Content="◈   Liquid Glass" Click="Preview_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="↶   Restore Center"/>
                            <Button Style="{StaticResource NavButton}" Content="⌕   System Analysis"/>
                            <TextBlock Text="YOUR COLLECTION" Style="{StaticResource SectionLabel}" Margin="9,27,0,10"/>
                            <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#A98BFF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Liquid Glass" Foreground="#EEE8FF" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="The first visual pack" Foreground="#8F8B9F" FontSize="10" Margin="14,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                                CornerRadius="14" Padding="13">
                            <StackPanel>
                                <TextBlock Text="GLASS ENGINE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="BackdropStatus" Text="Initializing…" Foreground="#E5DEFF"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                <TextBlock Text="Windows 11 material with a styled fallback." TextWrapping="Wrap"
                                           Foreground="#9793A7" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,25,30,28">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="THE PERSONALIZATION STUDIO" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="A clearer view of your style." FontSize="27" FontWeight="SemiBold"
                                           Foreground="#F8F5FF" Margin="0,7,0,0"/>
                                <TextBlock Text="Make Windows feel like it belongs to you." FontSize="12"
                                           Foreground="#B2AEC0" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1FFFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="12,8" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#F3C56E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SAFE PREVIEW" FontSize="9" Foreground="#E9DDBD" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Liquid Glass feature hero -->
                        <Border Height="226" CornerRadius="23" BorderBrush="#65D7C8FF" BorderThickness="1"
                                Background="#241B1933" Padding="24" Margin="0,0,0,20">
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#443E2F68" Offset="0"/>
                                        <GradientStop Color="#30212B48" Offset="0.55"/>
                                        <GradientStop Color="#20203448" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" MaxWidth="520">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#45FFFFFF" BorderBrush="#65FFFFFF" BorderThickness="1"
                                                CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="FIRST PACK · LIQUID GLASS" FontSize="9"
                                                       Foreground="#E5DFFF" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="  ✦" Foreground="#D1B9FF" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="More depth.\nMore light. More you." FontSize="28"
                                               FontWeight="SemiBold" Foreground="White" Margin="0,13,0,0"/>
                                    <TextBlock Text="A frosted, layered interface with translucent panels, gentle highlights and a soft violet glow."
                                               TextWrapping="Wrap" Foreground="#C2BED0" FontSize="12" Margin="0,9,0,16"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Explore Liquid Glass  →"
                                            HorizontalAlignment="Left" Click="Preview_Click"/>
                                </StackPanel>

                                <!-- Glass sample composition -->
                                <Grid Grid.Column="1" Margin="12,0,0,0">
                                    <Ellipse Width="190" Height="190" Fill="#6C9474FF" Opacity="0.16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect><BlurEffect Radius="34"/></Ellipse.Effect>
                                    </Ellipse>
                                    <Border Width="218" Height="152" Background="#35FFFFFF" BorderBrush="#80FFFFFF"
                                            BorderThickness="1" CornerRadius="19" Padding="12"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Effect><DropShadowEffect Color="#05030D" BlurRadius="28" ShadowDepth="8" Opacity="0.45"/></Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <Ellipse Width="6" Height="6" Fill="#FF8E9C" Margin="0,0,5,0"/>
                                                <Ellipse Width="6" Height="6" Fill="#FFD17C" Margin="0,0,5,0"/>
                                                <Ellipse Width="6" Height="6" Fill="#8FE0B1"/>
                                                <TextBlock Text="  GLASS PANEL" FontSize="8" Foreground="#ECE8F6" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Background="#25FFFFFF" CornerRadius="8" Margin="0,0,7,0"/>
                                                <StackPanel Grid.Column="1" Margin="2,4,0,0">
                                                    <Border Height="9" Width="92" HorizontalAlignment="Left" Background="#A9FFFFFF" CornerRadius="5"/>
                                                    <Border Height="6" Width="138" HorizontalAlignment="Left" Background="#55FFFFFF" CornerRadius="4" Margin="0,8,0,0"/>
                                                    <Border Height="6" Width="110" HorizontalAlignment="Left" Background="#40FFFFFF" CornerRadius="4" Margin="0,5,0,0"/>
                                                    <Border Height="32" Background="#428C6EFF" BorderBrush="#70D7C8FF" BorderThickness="1"
                                                            CornerRadius="8" Margin="0,13,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="WINDOWS COMPATIBILITY" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock x:Name="OsStatus" Text="Checking…" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#F4F0FF" Margin="0,9,0,0"/>
                                    <TextBlock x:Name="OsVersion" Text="Windows version details" FontSize="10"
                                               Foreground="#AAA6B8" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16" Margin="4,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="TRANSPARENCY" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock x:Name="TransparencyStatus" Text="Not checked" FontSize="17"
                                               FontWeight="SemiBold" Foreground="#F4F0FF" Margin="0,9,0,0"/>
                                    <TextBlock Text="Windows personalization preference" FontSize="10"
                                               Foreground="#AAA6B8" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16" Margin="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="CHANGE SAFETY" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Approval first" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#F4F0FF" Margin="0,9,0,0"/>
                                    <TextBlock Text="Nothing changes without confirmation" FontSize="10"
                                               Foreground="#AAA6B8" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM CHECK" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Know your setup before you style it." FontSize="16"
                                               FontWeight="SemiBold" Foreground="#F4F0FF" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="ScanSummary" Text="Run a read-only check of your Windows version and transparency preference."
                                               Foreground="#AAA6B8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,13"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Run safe scan" HorizontalAlignment="Left"
                                            Click="Scan_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="18" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="BUILT WITH CARE" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Your PC stays in control." FontSize="16" FontWeight="SemiBold"
                                               Foreground="#F4F0FF" Margin="0,7,0,0"/>
                                    <TextBlock Text="This preview changes only the appearance of this app. System customization features are not enabled yet."
                                               TextWrapping="Wrap" Foreground="#AAA6B8" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="MATRIX CUSTUMUSE  ·  WINDOWS 11  ·  PREVIEW 0.1.1"
                                   Foreground="#777386" FontSize="9" HorizontalAlignment="Right" Margin="0,18,2,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>