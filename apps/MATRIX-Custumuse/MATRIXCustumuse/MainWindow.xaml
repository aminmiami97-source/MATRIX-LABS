<Window x:Class="MATRIXCustumuse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MATRIX Custumuse" Height="760" Width="1180" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#0A0B10" Foreground="#F4F4FA">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B9BBC8"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#8C6DFF"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#10121A" BorderBrush="#222430" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,22,18,20">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,4,0,30">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#252035" BorderBrush="#57418C" BorderThickness="1">
                            <TextBlock Text="M" FontSize="22" FontWeight="Bold" Foreground="#B69BFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MATRIX" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="CUSTUMUSE" FontSize="10" Foreground="#A28AFF"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="10" Foreground="#777B8C" Margin="8,0,0,8"/>
                    <Button Style="{StaticResource NavButton}" Content="⌂   Overview" Background="#242033" Foreground="#C2AFFF"/>
                    <Button Style="{StaticResource NavButton}" Content="◈   Themes"/>
                    <Button Style="{StaticResource NavButton}" Content="◌   Liquid Glass"/>
                    <Button Style="{StaticResource NavButton}" Content="↶   Restore Center"/>
                    <Button Style="{StaticResource NavButton}" Content="⌕   System Analysis"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#171923" BorderBrush="#2A2C39" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel>
                        <TextBlock Text="PREVIEW BUILD" FontSize="10" Foreground="#9A85FF" FontWeight="Bold"/>
                        <TextBlock Text="v0.1.0 · Foundation" Margin="0,7,0,0" Foreground="#C6C7D2" FontSize="12"/>
                        <TextBlock Text="Customization packs will be added gradually." TextWrapping="Wrap" Foreground="#777B8C" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,30,36,32">
                <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="OVERVIEW" Foreground="#9B7BFF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Your Windows, reimagined." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="A preview of the customization workspace." Foreground="#A2A5B3" Margin="0,8,0,0" FontSize="14"/></StackPanel>
                    <Border Grid.Column="1" Background="#1A1B24" CornerRadius="12" BorderBrush="#30313C" BorderThickness="1" Padding="13,9" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#F0B84C" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Prototype mode" Foreground="#D2D3DD" FontSize="12"/></StackPanel>
                    </Border>
                </Grid>
                <Border Background="#171923" BorderBrush="#2B2D3A" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,0,0,20">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="LIQUID GLASS PACK" Foreground="#B69BFF" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="A softer, translucent Windows look" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0"/>
                            <TextBlock Text="Explore the first customization pack with glass-inspired surfaces, subtle highlights, and a cohesive accent color." Foreground="#A2A5B3" TextWrapping="Wrap" MaxWidth="580" Margin="0,8,0,16"/>
                            <Button Style="{StaticResource ActionButton}" Content="Open Liquid Glass Preview" HorizontalAlignment="Left" Click="Preview_Click"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="220" Height="142" CornerRadius="16" Background="#242332" BorderBrush="#4C426D" BorderThickness="1" Margin="18,0,0,0">
                            <Grid><Rectangle Fill="#8B74FF" Opacity="0.12" RadiusX="16" RadiusY="16"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="84" Height="44" Background="#B6A3FF" Opacity="0.18" BorderBrush="#D5CAFF" BorderThickness="1" CornerRadius="12"/>
                                <Border Width="128" Height="30" Background="#FFFFFF" Opacity="0.08" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0"/>
                            </StackPanel></Grid>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="SYSTEM STATUS" Foreground="#777B8C" FontSize="11" FontWeight="Bold" Margin="2,4,0,12"/>
                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#151720" BorderBrush="#282A36" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="OS compatibility" Foreground="#A2A5B3" FontSize="12"/><TextBlock x:Name="OsStatus" Text="Checking…" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="OsVersion" Text="Windows version details" Foreground="#777B8C" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#151720" BorderBrush="#282A36" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="Transparency" Foreground="#A2A5B3" FontSize="12"/><TextBlock x:Name="TransparencyStatus" Text="Not checked" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Windows personalization setting" Foreground="#777B8C" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#151720" BorderBrush="#282A36" BorderThickness="1" CornerRadius="14" Padding="18">
                        <StackPanel><TextBlock Text="Safety" Foreground="#A2A5B3" FontSize="12"/><TextBlock Text="Review before apply" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Changes require your approval" Foreground="#777B8C" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                </Grid>
                <Border Background="#11131B" BorderBrush="#2B2D39" BorderThickness="1" CornerRadius="14" Padding="16">
                    <DockPanel><StackPanel><TextBlock Text="SYSTEM CHECK" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="ScanSummary" Text="No scan has been run yet." Foreground="#A2A5B3" FontSize="12" Margin="0,6,0,0"/></StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Run safe scan" Click="Scan_Click" Margin="18,0,0,0"/></DockPanel>
                </Border>
                <TextBlock Text="No settings are changed by this preview build." Foreground="#737786" FontSize="11" Margin="4,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>